{
	"name": "canvas-sketchpad-mcp",
	"version": "1.0.0",
	"description": "AI Canvas Drawing Service with MCP Server",
	"main": "src/index.ts",
	"scripts": {
		"dev": "npm run build:frontend && tsx watch src/index.ts",
		"start": "node dist/index.js",
		"build": "tsc",
		"build:frontend": "esbuild ./src/public/main.ts --bundle --outfile=./src/public/dist/main.js --minify",
		"build:all": "npm run build && npm run build:frontend",
		"format": "biome format --write"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.0.4",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^22.0.0",
		"@types/ws": "^8.5.13",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"ws": "^8.18.0",
		"zod": "^4.1.5",
		"zod-to-json-schema": "^3.24.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.3",
		"esbuild": "^0.25.0",
		"tsx": "^4.19.1",
		"typescript": "^5.0.0"
	},
	"type": "module",
	"packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
